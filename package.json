{
  "name": "oc-free-relay",
  "version": "1.0.0",
  "description": "Standalone OpenCode free-worker LLM gateway: OpenAI-compatible passthrough to opencode.ai/zen with multi-key rotation and admin UI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "llm",
    "gateway",
    "opencode",
    "openai-compatible",
    "proxy"
  ],
  "license": "MIT",
  "dependencies": {
    "fetch-socks": "^1.3.2",
    "undici": "^7.8.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
